diff --git a/hartattack/hartattack/staticblocks/blackparrot_sync.py b/hartattack/hartattack/staticblocks/blackparrot_sync.py
new file mode 100644
index 0000000000000000000000000000000000000000..20e4247f0ab8d3a68e540222d6f462872c089c4c
--- /dev/null
+++ b/hartattack/hartattack/staticblocks/blackparrot_sync.py
@@ -0,0 +1,151 @@
+# Copyright 2026 Flavien Solt, Quentin Bordier ETH Zurich.
+# Licensed under the General Public License, Version 3.0, see LICENSE for details.
+# SPDX-License-Identifier: GPL-3.0-only
+"""Scalar four-hart synchronization for the BlackParrot test target.
+
+Only reserved helper registers are changed. The ELF template owns an initialized
+80-byte region immediately after coresync_addrs. Each arrival/done slot has one
+writer. Hart zero resets MCM data before publishing the release epoch. Any hart
+entering the final block ends further resets and releases peers still waiting.
+"""
+from ..params import CORESYNC_ADDR_REG, MCM_RESET_REG, RELOCATOR_REG
+from ..riscv import CSR, FenceOrdering, ILEN, IntReg
+from ..instgen import (BranchInstr, CSRRegInstr, FenceInstr, ImmRdInstr,
+                       IntLoadInstr, IntStoreInstr, JALInstr, JALRInstr,
+                       R12DInstr, RegImmInstr, WfiInstr)
+from ..asm import li_into_reg
+
+SYNC_OFFSET = 0x400
+RELEASE = 0
+STOP = 8
+ARRIVAL = 16
+DONE = 48
+SYNC_BYTES = 80
+_BASE = CORESYNC_ADDR_REG[0]
+_EPOCH = RELOCATOR_REG[0]
+_VALUE = IntReg.t4
+_POINTER = IntReg.t3
+
+
+class _Block:
+    def __init__(self):
+        self.instructions = []
+        self.labels = {}
+        self.branches = []
+
+    def emit(self, instruction):
+        self.instructions.append(instruction)
+
+    def label(self, name):
+        if name in self.labels:
+            raise ValueError(f'duplicate synchronization label {name}')
+        self.labels[name] = len(self.instructions)
+
+    def branch(self, opcode, left, right, target):
+        self.branches.append((len(self.instructions), target))
+        self.emit(BranchInstr(opcode, left, right, 0, True, True, fixed_opcode=True))
+
+    def jump(self, target):
+        self.branches.append((len(self.instructions), target))
+        self.emit(JALInstr('jal', IntReg.zero, 0, True))
+
+    def finish(self):
+        for index, target in self.branches:
+            self.instructions[index].imm = (self.labels[target] - index) * ILEN
+        return self.instructions
+
+
+def _require_four_harts(test_params):
+    if not test_params.is_rv64 or test_params.hartids != [0, 1, 2, 3]:
+        raise ValueError('BlackParrot scalar synchronization requires RV64 harts 0..3')
+
+
+def _load(block, target, base, offset):
+    block.emit(IntLoadInstr('ld', target, base, offset, None, True))
+
+
+def _store(block, base, source, offset):
+    block.emit(IntStoreInstr('sd', base, source, offset, None, True))
+
+
+def _fence(block):
+    block.emit(FenceInstr('fence', FenceOrdering.RW_RW))
+
+
+def _restore_helpers(block):
+    block.label('restore')
+    block.emit(RegImmInstr('addi', _EPOCH, IntReg.zero, 1, True))
+    block.emit(RegImmInstr('slli', _EPOCH, _EPOCH, 31, True))
+    block.emit(ImmRdInstr('lui', _VALUE, 0b110, True))
+    block.emit(RegImmInstr('srli', _POINTER, _VALUE, 2, True))
+    block.emit(RegImmInstr('addi', _BASE, _BASE, -SYNC_OFFSET, True))
+    _fence(block)
+    block.emit(JALRInstr('jalr', IntReg.zero, MCM_RESET_REG, 0, None, True))
+
+
+def gen_blackparrot_reset(fuzzerstate, test_params):
+    _require_four_harts(test_params)
+    block = _Block()
+    _fence(block)
+    block.emit(RegImmInstr('addi', _BASE, _BASE, SYNC_OFFSET, True))
+    _load(block, _VALUE, _BASE, STOP)
+    block.branch('bne', _VALUE, IntReg.zero, 'restore')
+    block.emit(CSRRegInstr('csrrs', _VALUE, IntReg.zero, CSR.MHARTID))
+    block.emit(RegImmInstr('slli', _POINTER, _VALUE, 3, True))
+    block.emit(R12DInstr('add', _POINTER, _BASE, _POINTER))
+    _load(block, _EPOCH, _POINTER, ARRIVAL)
+    block.emit(RegImmInstr('addi', _EPOCH, _EPOCH, 1, True))
+    _store(block, _POINTER, _EPOCH, ARRIVAL)
+    _fence(block)
+    block.branch('bne', _VALUE, IntReg.zero, 'wait_release')
+    for hart in range(4):
+        block.label(f'wait_arrival_{hart}')
+        _load(block, _VALUE, _BASE, STOP)
+        block.branch('bne', _VALUE, IntReg.zero, 'restore')
+        _load(block, _VALUE, _BASE, ARRIVAL + 8 * hart)
+        block.branch('bltu', _VALUE, _EPOCH, f'wait_arrival_{hart}')
+    _fence(block)
+    for address in fuzzerstate.store_locations:
+        upper, lower = li_into_reg(address)
+        block.emit(RegImmInstr('addi', _VALUE, IntReg.zero, 1, True))
+        block.emit(RegImmInstr('slli', _VALUE, _VALUE, 31, True))
+        block.emit(ImmRdInstr('lui', _POINTER, upper, True))
+        block.emit(RegImmInstr('addi', _POINTER, _POINTER, lower, True))
+        block.emit(R12DInstr('add', _POINTER, _POINTER, _VALUE))
+        _store(block, _POINTER, IntReg.zero, 0)
+    _fence(block)
+    _store(block, _BASE, _EPOCH, RELEASE)
+    block.jump('restore')
+    block.label('wait_release')
+    _load(block, _VALUE, _BASE, STOP)
+    block.branch('bne', _VALUE, IntReg.zero, 'restore')
+    _load(block, _VALUE, _BASE, RELEASE)
+    block.branch('bltu', _VALUE, _EPOCH, 'wait_release')
+    _restore_helpers(block)
+    instructions = block.finish()
+    if len(instructions) * ILEN > 0x1000:
+        raise ValueError('BlackParrot MCM handler exceeds its reserved page')
+    fuzzerstate.mcm_state_rst_instrs = instructions
+
+
+def gen_blackparrot_terminal(test_params, is_rtl):
+    _require_four_harts(test_params)
+    block = _Block()
+    _fence(block)
+    block.emit(RegImmInstr('addi', _BASE, _BASE, SYNC_OFFSET, True))
+    block.emit(RegImmInstr('addi', _VALUE, IntReg.zero, 1, True))
+    _store(block, _BASE, _VALUE, STOP)
+    _fence(block)
+    block.emit(CSRRegInstr('csrrs', _POINTER, IntReg.zero, CSR.MHARTID))
+    block.emit(RegImmInstr('slli', _POINTER, _POINTER, 3, True))
+    block.emit(R12DInstr('add', _POINTER, _BASE, _POINTER))
+    _store(block, _POINTER, _VALUE, DONE)
+    _fence(block)
+    for hart in range(4):
+        block.label(f'wait_done_{hart}')
+        _load(block, _VALUE, _BASE, DONE + hart * 8)
+        block.branch('beq', _VALUE, IntReg.zero, f'wait_done_{hart}')
+    _fence(block)
+    if is_rtl:
+        block.emit(WfiInstr())
+    return block.finish()
