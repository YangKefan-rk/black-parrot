@@ -149,10 +152,11 @@ class CoreState:
-    def pick_allowed_intregs(self, prng: Random):
-        """Generates the list of allowed integer register for the current
-        testcase, the last register is never x0 for convinience
-        """
-        intregs = list(IntReg)[:MAX_NUM_PICKABLE_INTREGS]
-        num_pickable_intregs = prng.randint(
-            MIN_NUM_PICKABLE_INTREGS, MAX_NUM_PICKABLE_INTREGS
-        )
-        allowed_intregs = prng.sample(intregs, num_pickable_intregs)
-        return allowed_intregs
+    def pick_allowed_intregs(
+        self, prng: Random, reserved_addr_regs: tuple[IntReg, ...] = ()
+    ):
+        """Pick fuzzing registers without reusing this program's address registers."""
+        intregs = [reg for reg in list(IntReg)[:MAX_NUM_PICKABLE_INTREGS]
+                   if reg not in reserved_addr_regs]
+        count = min(prng.randint(MIN_NUM_PICKABLE_INTREGS, MAX_NUM_PICKABLE_INTREGS),
+                    len(intregs))
+        if count < MIN_NUM_PICKABLE_INTREGS:
+            raise ValueError('too few integer registers after address reservation')
+        return prng.sample(intregs, count)
