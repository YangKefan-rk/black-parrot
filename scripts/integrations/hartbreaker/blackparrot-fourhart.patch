diff --git a/hartattack/hartattack/rtlsim/blackparrot.py b/hartattack/hartattack/rtlsim/blackparrot.py
new file mode 100644
index 0000000000000000000000000000000000000000..b44ad060d49dbdfe2109635248d306417aa76c5d
--- /dev/null
+++ b/hartattack/hartattack/rtlsim/blackparrot.py
@@ -0,0 +1,105 @@
+# Copyright 2026 Flavien Solt, Quentin Bordier ETH Zurich.
+# Licensed under the General Public License, Version 3.0, see LICENSE for details.
+# SPDX-License-Identifier: GPL-3.0-only
+"""Native retired-load outcomes for the restricted four-hart BlackParrot target.
+
+Input is BP_DIFFTEST_S_TRACE TSV, never the Difftest-S verdict. A complete native
+source closure and one final WFI per hart are required. H still runs HartBreaker's
+own MCM/Dat3M verifier after this parser; parsing is not a memory-model verdict.
+"""
+from ..mcm.memops import Amo, Load
+
+BOOT = 0x80000000
+
+
+def _expected_loads(corestates, mcmstate):
+    loads = {}
+    for step in mcmstate.steps:
+        for hart, operations in step.step_memops.items():
+            for operation in operations.values():
+                if isinstance(operation, Amo):
+                    raise ValueError('BlackParrot scalar outcome parser does not support AMO')
+                if not isinstance(operation, Load):
+                    continue
+                pc = operation.exec_addr + BOOT
+                if pc in loads:
+                    raise ValueError('MCM outcome PC is not unique across harts/steps')
+                bb, index = operation.instr_coord
+                instruction = corestates[hart].basic_blocks[bb][index]
+                rd = instruction.rd.value
+                if rd == 0:
+                    raise ValueError('MCM load to x0 has no native architectural result')
+                loads[pc] = (hart, rd, instruction.gen_bytecode_int(False))
+    if set(loads) != set(mcmstate.get_all_load_addrs()):
+        raise ValueError('MCM expected load set cannot be bound to original instruction metadata')
+    return loads
+
+
+def parse_blackparrot_trace(lines, corestates, mcmstate):
+    if set(corestates) != set(range(4)):
+        raise ValueError('BlackParrot parser requires exactly harts 0..3')
+    expected = _expected_loads(corestates, mcmstate)
+    registers = {hart: [0] * 32 for hart in corestates}
+    counts = {hart: 0 for hart in corestates}
+    initialized, closed, identities, observed = set(), set(), set(), {}
+    terminal = {hart: False for hart in corestates}
+    prefix_closed = False
+    for line in lines:
+        fields = line.strip().split('\t')
+        kind = fields[0]
+        if kind in ('TRAP', 'ERROR'):
+            raise ValueError('native BlackParrot trace contains a trap or transport error')
+        if kind == 'INIT':
+            if len(fields) != 3:
+                raise ValueError('malformed native INIT')
+            hart, total = map(int, fields[1:])
+            if total != 4 or hart not in registers or counts[hart]:
+                raise ValueError('native hart initialization/reset differs from the fixed roster')
+            initialized.add(hart)
+        elif kind == 'RETIRE':
+            if len(fields) != 13:
+                raise ValueError('malformed native RETIRE')
+            hart, epoch, uid, attempt, tick, pc, raw, length, rd, write, fp, value = map(int, fields[1:])
+            identity = (hart, epoch, uid)
+            if (hart not in initialized or hart in closed or prefix_closed or terminal[hart] or
+                min(epoch, uid, attempt) <= 0 or tick < 0 or length not in (2, 4) or
+                not 0 <= rd < 32 or write not in (0, 1) or fp != 0 or not 0 <= value < 1 << 64 or
+                identity in identities):
+                raise ValueError('invalid, duplicate, post-terminal, or floating retirement')
+            identities.add(identity)
+            if length != 4:
+                raise ValueError('this HartBreaker target emits uncompressed scalar instructions')
+            if raw & 0x7f in (0x2f, 0x07, 0x27, 0x53, 0x57):
+                raise ValueError('native retirement exceeds the scalar outcome profile')
+            counts[hart] += 1
+            count = counts[hart]
+            if count <= 31 and (pc != BOOT + 4*(count-1) or raw != 0x13 | count << 7 or
+                                rd != count or write != 1 or value != 0):
+                raise ValueError('native bootstrap lacks independently specified GPR zero prefix')
+            if write:
+                if rd == 0:
+                    raise ValueError('native writeback illegally writes x0')
+                registers[hart][rd] = value
+            if pc in expected:
+                want_hart, want_rd, want_raw = expected[pc]
+                if (hart, rd, raw) != (want_hart, want_rd, want_raw) or not write or pc in observed:
+                    raise ValueError('MCM load retirement does not match its unique generated instruction')
+                observed[pc] = value
+            terminal[hart] = raw == 0x10500073
+        elif kind == 'CLOSE_HART':
+            if len(fields) != 4:
+                raise ValueError('malformed native hart closure')
+            hart, tick, uid = map(int, fields[1:])
+            if hart not in initialized or hart in closed or not terminal[hart] or counts[hart] < 32:
+                raise ValueError('native closure lacks a unique final WFI for this hart')
+            closed.add(hart)
+        elif kind == 'CLOSE_PREFIX':
+            if len(fields) != 2 or prefix_closed or closed != set(range(4)):
+                raise ValueError('native source prefix closed before every hart')
+            prefix_closed = True
+    if initialized != set(range(4)) or closed != initialized or not prefix_closed:
+        raise ValueError('native trace has no complete four-hart source closure')
+    if set(observed) != set(expected):
+        raise ValueError('native trace omits one or more generated MCM loads')
+    mcmstate.outcome = observed
+    return registers, {hart: [] for hart in corestates}
